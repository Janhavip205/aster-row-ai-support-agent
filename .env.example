# Google Gemini API Key (Required for model generation)
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (e.g., gemini-2.5-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local Embedding Model (HuggingFace sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Observability / Debug Mode (true/false)
DEBUG=false
